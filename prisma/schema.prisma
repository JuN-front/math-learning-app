generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  personal_id String   @unique
  username    String
  password    String
  role        String   @default("user")
  group       String?                        // ← 追加
  created_at  DateTime @default(now())

  progress    Progress[]
  assignments ItemSubmission[]
  event_logs  EventLog[]
  responses   QuestionResponse[]             // ← 追加
}

model Unit {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  order       Int
  created_at  DateTime  @default(now())

  contents    Content[]
}

model Content {
  id              String   @id @default(cuid())
  unit_id         String
  title           String
  description     String   @default("")
  order           Int
  lock_conditions String[] @default([])
  created_at      DateTime @default(now())

  unit        Unit            @relation(fields: [unit_id], references: [id], onDelete: Cascade)
  items       ContentItem[]
  progress    Progress[]
  submissions ItemSubmission[]
  event_logs  EventLog[]
  questions   Question[] 
}

model ContentItem {
  id         String   @id @default(cuid())
  content_id String
  type       String
  label      String
  file_path  String?
  url        String?
  order      Int      @default(0)
  created_at DateTime @default(now())

  content     Content         @relation(fields: [content_id], references: [id], onDelete: Cascade)
  submissions ItemSubmission[]
  event_logs  EventLog[]
}

model Progress {
  id         String   @id @default(cuid())
  user_id    String
  content_id String
  status     String   @default("not_started")
  updated_at DateTime @updatedAt

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  content Content @relation(fields: [content_id], references: [id], onDelete: Cascade)

  @@unique([user_id, content_id])
}

model ItemSubmission {
  id           String   @id @default(cuid())
  user_id      String
  content_id   String
  item_id      String
  file_path    String
  filename     String
  submitted_at DateTime @default(now())

  user    User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  content Content     @relation(fields: [content_id], references: [id], onDelete: Cascade)
  item    ContentItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@unique([user_id, item_id])
}

model EventLog {
  id          String   @id @default(cuid())
  user_id     String
  content_id  String?
  item_id     String?
  event       String
  payload     Json?
  client_time DateTime
  created_at  DateTime @default(now())

  user    User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  content Content?     @relation(fields: [content_id], references: [id], onDelete: SetNull)
  item    ContentItem? @relation(fields: [item_id], references: [id], onDelete: SetNull)

  @@index([user_id, content_id])
}

model Question {
  id               String    @id @default(cuid())
  content_id       String
  order            Int       @default(0)
  phase            String                     // 'practice' | 'pre' | 'post'
  body             String
  answer_mode      String    @default("staged")  // 'staged' | 'simple'
  accepted_answers String[]
  allow_attachment Boolean   @default(false)
  show_feedback    Boolean   @default(false)
  published        Boolean   @default(false)
  level            String?                    // 'L0' | 'L1' | 'L2'。practice は null
  set_key          String?                    // practice は null
  groups           String[]  @default([])     // practice は空配列
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  content   Content            @relation(fields: [content_id], references: [id], onDelete: Cascade)
  responses QuestionResponse[]

  @@index([content_id])
}

model QuestionResponse {
  id                  String    @id @default(cuid())
  user_id             String
  question_id         String
  attempt             Int       @default(1)
  group               String?
  understanding       String?
  extraction          String?
  equation            String?
  answer              String
  check               String?
  attachment_url      String?
  is_correct          Boolean
  is_correct_override Boolean?
  started_at          DateTime
  submitted_at        DateTime  @default(now())

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  question Question @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@index([user_id, question_id])
}